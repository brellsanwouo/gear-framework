namespace AgentDefinition

features
	ADKAgent {abstract}
		mandatory
			BaseAgent {abstract}
				mandatory
					AgentType {abstract}
						alternative
							LlmAgent {abstract}
							SequentialAgent {abstract}
							ParallelAgent {abstract}
							LoopAgent {abstract}
							CustomAgent {abstract}
							RemoteA2AAgent {abstract}
								mandatory
									AgentCardReference {abstract}
										alternative
											AgentCardURL {abstract}
											AgentCardJSON {abstract}
					Name {abstract}
				optional
					Description {abstract}
					SubAgents {abstract}
					Constraints {abstract}
		optional
			LLMAgentConfig {abstract}
				mandatory
					Model {abstract}
				optional
					GenerateContentConfig {abstract}
						optional
							Temperature {abstract}
							MaxOutputTokens {abstract}
							TopP {abstract}
							TopK {abstract}
							SafetySettings {abstract}
			Configurations {abstract}
				mandatory
					Instruction {abstract}
				optional
					Tools {abstract}
						or
							ThirdPartyTools {abstract}
							FunctionTools {abstract}
							MCPTools {abstract}
							AgentTool {abstract}
							BaseTools {abstract}
								or
									GeminiTools {abstract}
									GoogleCloudTools {abstract}
					DataStructure {abstract}
						optional
							OutputKey {abstract}
							InputSchema {abstract}
							OutputSchema {abstract}
					IncludeContents {abstract}
						alternative
							Default
							None
					Planner {abstract}
						optional
							BuiltInPlanner {abstract}
								optional
									ThinkingConfig {abstract}
										or
											IncludeThoughts
											ThinkingBudget
							PlanReactPlanner
					CodeExecutor {abstract}
			Guardrails {abstract}
				optional
					AgentLifecycle {abstract}
						or
							BeforeAgentCallback {abstract}
							AfterAgentCallback {abstract}
					ModelInteraction {abstract}
						or
							BeforeModelCallback {abstract}
							AfterModelCallback {abstract}
					ToolExecution {abstract}
						or
							BeforeToolCallback {abstract}
							AfterToolCallback {abstract}