namespace ADKMultiAgentSystem

features
	ADKMultiAgentSystem {abstract true}
		mandatory
			SystemDefinition {abstract true}
				mandatory
					RootAgent {abstract true}
					Agents {abstract true}
				optional
					OrchestrationMechanisms {abstract true}
						alternative
							WorkflowAgents {abstract true}
								or
									SequentialAgent {abstract true}
									ParallelAgent {abstract true}
									LoopAgent {abstract true}
							Agent2Agent {abstract true}
							CustomAgent {abstract true}
			Infrastructure {abstract true}
				optional
					Runner {abstract true}
						optional
							Configuration {abstract true}
								optional
									RequiredParameters {abstract true}
										or
											Agent {abstract true}
											SessionService {abstract true}
									OptionalParameters {abstract true}
										or
											MemoryService {abstract true}
											ArtifactService {abstract true}
					SessionServiceConfig {abstract true}
						optional
							Session_Implementations {abstract true}
								or
									InMemorySessionService {abstract true}
									DatabaseSessionService {abstract true}
									VertexAiSessionService {abstract true}
							Sessions_Operations {abstract true}
								or
									CreateSession {abstract true}
									GetSession {abstract true}
									AppendEvent {abstract true}
									ListSessions {abstract true}
									DeleteSession {abstract true}
					MemoryServiceConfig {abstract true}
						optional
							Memory_Implementations {abstract true}
								or
									InMemoryMemoryService {abstract true}
									VertexAiMemoryBankService {abstract true}
							Memory_Operations {abstract true}
								or
									AddSessionToMemory {abstract true}
									SearchMemory {abstract true}
							MemoryIntegrationTools {abstract true}
								or
									PreloadMemory {abstract true}
									LoadMemory {abstract true}
					ArtifactServiceConfig {abstract true}
						optional
							Artefact_Implementations {abstract true}
								or
									InMemoryArtifactService {abstract true}
									GcsArtifactService {abstract true}
							Artefact_Operations {abstract true}
								or
									SaveArtifact {abstract true}
									LoadArtifact {abstract true}
									ListArtifacts {abstract true}
							Scoping {abstract true}
								or
									SessionScoped {abstract true}
									UserScoped {abstract true}
							Versioning {abstract true}
								mandatory
									Automatic {abstract true}
			EventsConfig {abstract true}
				optional
					Storage {abstract true}
						mandatory
							SessionEvents {abstract true}
					EventTypes {abstract true}
						or
							UserMessage {abstract true}
							AgentResponse {abstract true}
							ToolCall {abstract true}
							ToolResult {abstract true}
							StateChange {abstract true}
							AgentTransfer {abstract true}
					EventActions {abstract true}
						or
							StateDelta {abstract true}
							Escalate {abstract true}

constraints
	Session_Implementations => Sessions_Operations
	Memory_Implementations => Memory_Operations
	Memory_Implementations => MemoryIntegrationTools