	APIKey => openai | OtherProvider
	BaseURL => ollama | OtherProvider
	ModelParameters => (Temperature | MaxTokens | TopP | StopSequences | AdditionalParams | TopK | FrequencyPenalty | PresencePenalty | Seed)
