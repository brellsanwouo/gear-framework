											alternative
												gpt_5_1_codex_mini
												OtherModel {abstract}
									optional
										APIKey {abstract}
										BaseURL {abstract}
										Timeout {abstract}
										MaxRetries {abstract}
										ModelParameters {abstract}
											optional
												Temperature {abstract}
												MaxTokens {abstract}
