namespace GearMultiAgent

features
	GearMultiAgent {abstract}
		mandatory
			Agents {abstract}
			Orchestration {abstract}
				mandatory
					Nodes {abstract}
						or
							AgentNode {abstract}
								mandatory
									AgentRef {abstract}
							OrchestrationNode {abstract}
								mandatory
									Strategy {abstract}
										alternative
											Sequential {abstract}
											Loop {abstract}
												mandatory
													TurnCount {abstract}
											Parallel {abstract}
												mandatory
													Aggregator {abstract}
											custom {abstract}
					Edges {abstract}
						mandatory
							FromNode {abstract}
							ToNode {abstract}
		optional
			RootNode {abstract}
			Memory {abstract}
