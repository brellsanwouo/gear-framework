features
    CrewAgent { abstract }
        mandatory
            CoreIdentity { abstract }
                mandatory
                    Role
                    Goal
                    Backstory
        optional
            LLMConfiguration { abstract }
                optional
                    Provider { abstract }
                        alternative
                            OpenAI_
                            Anthropic
                            GoogleGemini
                            AWSBedrock_
                            Azure
                            OtherProviders
                    ConfigurationMethod { abstract }
                        alternative
                            EnvVarModel
                            YamlLLM
                            PythonLLMObject
                    Parameters { abstract }
                        or
                            Temperature
                            MaxTokens
                            TopP
                            FrequencyPenalty
                            PresencePenalty
                            Seed
                            Stop
                            Timeout
                            MaxRetries
                            ReasoningEffort
                    StructuredOutputs
                    MultimodalCapabilities
            ExecutionParameters { abstract }
                or
                    MaxIter
                    MaxRPM
                    MaxExecutionTime
                    MaxRetryLimit
                    RespectContextWindow
            Tools { abstract }
                optional
                    Sources { abstract }
                        or
                            CrewAIToolkit
                            LangChain
                            CustomTools
                    ToolCreationMethods { abstract }
                        or
                            Subclassing
                            Decorator
                    AsyncToolSupport
                    ToolCaching
            BehavioralControls { abstract }
                or
                    AllowDelegation
                    AllowCodeExecution
                    Verbose
                    Cache
            Memory { abstract }
                optional
                    Types { abstract }
                        or
                            ShortTermMemory
                            LongTermMemory
                            EntityMemory
                            ContextualMemory
                    Storage { abstract }
                        or
                            DefaultLocations
                            CustomStorage
                    EmbeddingProviders { abstract }
                        or
                            OpenAI
                            Ollama
                            AzureOpenAI
                            GoogleAI
                            VertexAI
                            Cohere
                            VoyageAI
                            AWSBedrock
                            HuggingFace
                            IBMWatson
                            Mem0
            Reasoning { abstract }
                optional
                    ReasoningEnabled
                    MaxReasoningAttempts
            KnowledgeSources { abstract }
                optional
                    IntegrationLevel { abstract }
                        alternative
                            AgentLevel
                            CrewLevel
                    SupportedFormats { abstract }
                        or
                            TextBased
                            StructuredData
                    Storage_ { abstract }
                        or
                            ChromaDB
                    RetrievalConfiguration
            TemplateCustomization { abstract }
                or
                    SystemTemplate
                    PromptTemplate
                    ResponseTemplate
            Tasks_ { abstract }
                optional
                    EssentialProperties { abstract }
                        mandatory
                            ExpectedOutput
                        optional
                            Agent
                            Name
                    ExecutionConfiguration { abstract }
                        or
                            Tools_
                            Context
                            AsyncExecution
                            HumanInput
                            Markdown
                    OutputManagement { abstract }
                        or
                            OutputFile
                            CreateDirectory
                            OutputJson
                            OutputPydantic
                            Callback
                            Config__
                    ValidationAndSafety { abstract }
                        optional
                            Guardrail
                            Guardrails__
                            GuardrailMaxRetries
                            GuardrailTypes { abstract }
                                alternative
                                    FunctionBased
                                    LLMBased
                    OutputStructure { abstract }
                        optional
                            Attributes { abstract }
                                or
                                    Raw_
                                    Pydantic
                                    JsonDict_
                                    Summary
                                    Agent_
                                    Messages
                            AccessPatterns { abstract }
                                or
                                    DictIndexing
                                    PropertyAccess
                                    ToDict
                                    StringRepresentation
                    DefinitionMethods { abstract }
                        alternative
                            YAMLConfiguration_
                            DirectCodeDefinition
                    ExecutionModels { abstract }
                        alternative
                            Sequential
                            Hierarchical
                    ConditionalTasks { abstract }
                        alternative
                            Flows_