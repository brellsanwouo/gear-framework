# Copy this file to .env, then replace the placeholder values.

# Required to execute generated CrewAI or Google ADK workflows.
# Uncomment this line and replace the placeholder with your OpenAI API key.
# OPENAI_API_KEY=sk-your-openai-api-key

# Optional aliases accepted by some frameworks/tools.
OPENAI_KEY=
OPENAI_TOKEN=

# Optional Google/Gemini keys, only needed for workflows that use them.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Studio model policy. Leave GEAR_STUDIO_MODEL empty to let users edit the
# provider and model per agent. Set it to enforce and lock both fields.
GEAR_STUDIO_PROVIDER=openai
GEAR_STUDIO_MODEL=

# Local Studio execution. Enable only for projects you trust.
GEAR_ENABLE_LOCAL_RUNNER=false
GEAR_RUNNER_TIMEOUT=180
GEAR_RUNNER_CPU_SECONDS=60
GEAR_RUNNER_MEMORY_MB=2048
GEAR_RUNNER_OUTPUT_MB=10

# Database settings are only needed when using the experiment/tracking branch.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gear
DB_NAME=gear
DATABASE_URL=
MLFLOW_TRACKING_URI=
GEAR_MLFLOW_ENABLED=true
MLFLOW_EXPERIMENT_NAME=gear-framework-production
GEAR_MLFLOW_LOG_OUTPUTS=true
GEAR_MLFLOW_MAX_LOG_CHARS=100000
MLFLOW_HTTP_REQUEST_TIMEOUT=5
MLFLOW_HTTP_REQUEST_MAX_RETRIES=1
