namespace GenericAgent

features
	GenericAgent {abstract true}
		mandatory
			AgentIdentity {abstract true}
				mandatory
					Name {abstract true}
					Purpose {abstract true}
				optional
					ContextDescription {abstract true}
			AgentType {abstract true}
				alternative
					SingleAgent
					MultiAgent {abstract true}
						alternative
							SequentialAgent
							ParallelAgent
							LoopAgent
							CustomAgent